# =============================================================================
# Přijímačky Lehce - proměnné prostředí
# Zkopírujte tento soubor jako `.env` a doplňte skutečné hodnoty.
#
# JEDINÁ POVINNÁ proměnná je DATABASE_URL. Všechno ostatní je volitelné -
# aplikace naběhne i bez nich, jen se postupně odemykají funkce (Google
# přihlášení, AI tutor, e-maily, rate limiting). Podrobnosti u každé sekce.
# =============================================================================

# --- Databáze (POVINNÉ) ------------------------------------------------------
# Nejrychlejší lokální varianta - Postgres v Dockeru, nic si nezakládáte:
#   docker compose up -d
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prijimacky_lehce"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prijimacky_lehce"

# Alternativa bez Dockeru - Supabase (zdarma): https://supabase.com
# DATABASE_URL="postgresql://postgres:[HESLO]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[HESLO]@[PROJECT-REF].supabase.co:5432/postgres"

# --- Auth.js (volitelné - má rozumný dev fallback) ---------------------------
NEXTAUTH_URL="http://localhost:3000"
# Bez téhle hodnoty aplikace naběhne (env.ts použije dočasnou dev hodnotu),
# ale před nasazením do produkce si vygenerujte vlastní:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Google OAuth (volitelné) -------------------------------------------
# Bez těchto klíčů prostě nepůjde tlačítko "Pokračovat s Google" na /login.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Gemini AI - Sokratovský tutor (volitelné) -------------------------------
# Bez klíče AI chat vrátí srozumitelnou chybu místo pádu aplikace.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# --- Resend - transakční e-maily, magic link (volitelné) --------------------
# Bez klíče jednoduše nepůjde magic-link přihlášení.
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="reporty@vase-domena.cz"

# --- Upstash Redis - rate limiting AI chatu (volitelné) ----------------------
# Bez klíčů se automaticky použije in-memory limiter (funguje pro lokální
# vývoj na jednom procesu, ale NENÍ vhodný pro produkci s víc instancemi).
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Stripe (doplní se v poslední fázi projektu) -----------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Obecné (volitelné - má výchozí hodnotu) ---------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
