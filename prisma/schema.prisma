// Prisma schema - Přijímačky Lehce
// PostgreSQL (Supabase), Repository Pattern implemented in src/lib/repositories

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// AUTH & USERS
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  image         String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  studentProfile StudentProfile?

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// PROFILES
// ---------------------------------------------------------------------------

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradeLevel      Int      @default(9)
  targetSchool    String?
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActivityAt  DateTime?
  totalXp         Int      @default(0)
  attempts        TaskAttempt[]
  testSessions    TestSession[]
  chatSessions    ChatSession[]
  subscription    Subscription?
  createdAt       DateTime @default(now())

  @@map("student_profiles")
}

// ---------------------------------------------------------------------------
// TASK BANK (CERMAT úlohy)
// ---------------------------------------------------------------------------

enum TaskTopic {
  CISLA_A_VYPOCTY
  ROVNICE_A_NEROVNICE
  VYRAZY
  GEOMETRIE_ROVINNA
  GEOMETRIE_PROSTOROVA
  SLOVNI_ULOHY
  FUNKCE_A_GRAFY
  STATISTIKA_A_PRAVDEPODOBNOST
  FINANCNI_MATEMATIKA
  LOGIKA_A_KOMBINATORIKA
}

enum TaskDifficulty {
  ZAKLADNI
  STREDNI
  POKROCILA
}

enum ExamTerm {
  RADNY_1
  RADNY_2
  NAHRADNI_1
  NAHRADNI_2
  ILUSTRACNI
}

model Task {
  id               String         @id @default(cuid())
  externalCode     String?        @unique // e.g. M9A_2026_15
  year             Int
  term             ExamTerm
  orderInTest      Int?
  topic            TaskTopic
  difficulty       TaskDifficulty
  statementLatex   String         @db.Text
  imageUrl         String?
  imageAlt         String?
  correctAnswer    String         @db.Text
  answerFormat     String // "text" | "number" | "choice"
  choices          Json? // for multiple choice: string[]
  solutionSteps    Json // structured step[] used to seed the Socratic tutor context
  sourceUrl        String?
  isPublished      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  attempts     TaskAttempt[]
  chatSessions ChatSession[]
  testTasks    TestSessionTask[]

  @@index([topic, difficulty])
  @@index([year, term])
  @@map("tasks")
}

model TaskAttempt {
  id               String         @id @default(cuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedAnswer  String         @db.Text
  isCorrect        Boolean
  hintsUsedCount   Int            @default(0)
  revealedSolution Boolean        @default(false)
  timeSpentSeconds Int
  testSessionId    String?
  testSession      TestSession?   @relation(fields: [testSessionId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([studentId, createdAt])
  @@index([taskId])
  @@map("task_attempts")
}

// ---------------------------------------------------------------------------
// AI SOCRATIC TUTOR CHAT
// ---------------------------------------------------------------------------

enum ChatRole {
  STUDENT
  TUTOR
  SYSTEM
}

model ChatSession {
  id             String        @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  tokensConsumed Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([studentId, taskId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          ChatRole
  content       String      @db.Text
  tokensUsed    Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------------
// TIMED EXAM SIMULATOR
// ---------------------------------------------------------------------------

enum TestSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model TestSession {
  id              String            @id @default(cuid())
  studentId       String
  student         StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          TestSessionStatus @default(IN_PROGRESS)
  timeLimitSeconds Int              @default(4200) // 70 minut
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  scoreCorrect    Int?
  scoreTotal      Int?
  tasks           TestSessionTask[]
  attempts        TaskAttempt[]

  @@index([studentId, status])
  @@map("test_sessions")
}

model TestSessionTask {
  id            String      @id @default(cuid())
  testSessionId String
  testSession   TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orderIndex    Int

  @@unique([testSessionId, taskId])
  @@map("test_session_tasks")
}

// ---------------------------------------------------------------------------
// SUBSCRIPTIONS (schema ready now, billing logic added later)
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  MONTHLY
  SEASONAL
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(cuid())
  studentId            String             @unique
  student              StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan?
  status               SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}
