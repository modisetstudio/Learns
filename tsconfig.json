{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // Vypnuto záměrně: rozlišuje "vlastnost chybí" od "vlastnost je undefined"
    // a v praxi neustále naráží na typy z Prisma/Zod/Playwright (způsobilo to
    // několik po sobě jdoucích pádů Vercel buildu). Zbytek strict módu zůstává.
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/types/*": ["./src/types/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/store/*": ["./src/store/*"],
      "@/config/*": ["./src/config/*"],
      "@/constants/*": ["./src/constants/*"]
    }
  },
  // Next.js `next build` typem kontroluje VŠECHNO, co matchne "include" níže.
  // Záměrně omezeno na `src/` - prisma/seed.ts (spouští se přes `tsx`),
  // playwright.config.ts a vitest.config.ts/setup.ts (spouští Playwright/
  // Vitest, ne Next.js) nejsou součástí aplikace a nemají appku blokovat,
  // když v nich vznikne typová chyba nekompatibilní s `exactOptionalPropertyTypes`.
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
